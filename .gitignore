# OS / Editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~

# Logs
*.log
npm-debug.log*

# Local env / secrets (defensive — no secrets in this project, but keep ignored)
.env
.env.local
.env.*.local

# Build artifacts (vanilla — no build step, but defensive)
node_modules/
dist/
build/
.cache/

# Backup / temp
*.bak
*.bak[0-9]*
*.corrupt
*.tmp
tmp/

# Coverage / test
coverage/
*.lcov

# Local Claude Code settings (per-user permission allowlists, etc.)
.claude/settings.local.json
.claude/*.local.json
.claude-local/

# AICoderMap skill artifacts (research-agent intermediate outputs + verification cache)
.aicodermap-*.json
.aicodermap-images/
.aicodermap-verification-map.json
.aicodermap-runtime/
.aicodermap-dispatch/

# FAZ 2.1 (2026-05-07): per-cycle leaderboard prefetch — stdlib-fetched HTML
# snapshots agent-readable from disk instead of WebFetched per-batch. ~40MB,
# regeneratable via `python scripts/prefetch-leaderboards.py`.
data/.leaderboard-snapshots/

# FAZ 4.C (2026-05-10): haiku gather agents sometimes write Python helper
# scripts to root (.gather-*.py) — not part of orchestrator protocol.
.gather-*.py
.gather-extract*.py

# Discovery review queue (human-gated; not committed until promoted)
data/discoveries.json

# ds-tune state + pre-push audit trail
.audit/*
!.audit/.gitkeep
auto/run.log

# Python bytecode (any depth)
__pycache__/
**/__pycache__/
*.pyc
*.pyo

# Lighthouse audit reports (generated, not committed)
docs/lighthouse/*.html
docs/lighthouse/*.json
