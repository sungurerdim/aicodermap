{
  "_schema": {
    "version": "1.0",
    "purpose": "Single source of truth for every URL the research agent is allowed to fetch. Skill loads this and passes via idea_context.sourcesWhitelist; agent uses it for trusted_sources_only=true enforcement, Phase 0 lineup discovery, Phase 1+2+3 mining, and per-model fallback. Tier weights drive trustScore (I=1.0, S=0.7, C=0.4, U=never-written).",
    "structure": {
      "vendors": "Per-vendor URL bundles. tier='S' (vendor self-report). Used by both Phase 0 lineup discovery (urls.lineup) and per-model S-tier fallback (urls.news/docs/pricing).",
      "leaderboards": "Independent benchmark sources. tier='I'. Used by Phase 1 mining.",
      "aggregators": "Multi-provider inference catalogs. tier='I'. Used by Phase 2 multi-provider pricing mining.",
      "local": "Local-runtime catalogs (Ollama, Unsloth, quants). tier='I'. Used per-model when tier='ollama' or vramRequirement is sought.",
      "registries": "Model metadata registries (HF leaderboard, llmfit). tier='I'.",
      "community": "Aggregator blogs / expert commentary. tier='C'. Used only when no I/S source carries the value."
    }
  },
