  "models": {
    "opus-4-7": {
      "strengths": "SWE-bench Pro liderliği (%64.3), MCP-Atlas araç kullanımında zirve (%77.3), 1M token bağlam penceresi, en yüksek görsel çözünürlük (3.75MP), CursorBench üzerinde %70 skor",
      "weaknesses": "GPT-5.4'e kıyasla yüksek fiyat ($5/$25), aaIdx skoru (57) GPT-5.5 ile eşit düzeyde ama çok daha pahalı"
    },
    "sonnet-4-6": {
      "strengths": "Fiyat/performans dengesi; geniş bağlam; Claude Code uyumu.",
      "weaknesses": "Frontier benchmark'larında Opus'un altında; veriler doğrulama bekliyor."
    },
    "gpt-5": {
      "strengths": "Geniş ekosistem entegrasyonu; OpenAI tooling olgunluğu.",
      "weaknesses": "Coding-spesifik benchmark verileri henüz çapraz doğrulanmadı."
    },
    "qwen-3-6-27b": {
      "strengths": "27B yoğun model, 35B MoE varyantı ile aynı ailede. 262K bağlam. Yerel çalıştırma için 35B A3B'ye iyi alternatif. Güçlü kodlama ve genel akıl yürütme.",
      "weaknesses": "Bağımsız benchmark verisi yetersiz. 35B A3B MoE varyantı genellikle aynı kullanım senaryosu için tercih ediliyor. Fiyatlandırma açıklanmadı."
    },
    "deepseek-v4": {
      "strengths": "MIT lisans; düşük maliyetli API; agentic kullanımda hızlı iterasyon.",
      "weaknesses": "Yeni çıktı, çapraz kaynak doğrulama hâlâ devam ediyor."
    },
    "kimi-k2-6": {
      "strengths": "SWE-Pro 58.6 ile açık ağırlık modeller arasında en yüksek skor. HLE-Full with Tools 54.0 GPT-5.4 ve Claude'u geçiyor. 300 eş zamanlı alt-ajan, 4000 adımlı koordineli ajan sürüsü. LiveCodeBench v6 %89.6 lider.",
      "weaknesses": "Modified MIT lisansı bazı ticari kısıtlamalar getiriyor. Matematik ve GPQA akıl yürütmede frontier gerisinde. Benchmark harness seçimi skoru birkaç puan etkileyebilir."
    },
    "deepseek-v4-flash": {
      "strengths": "284B toplam / 13B aktif MoE, MIT lisansı. $0.14 girişle piyasanın en ucuz frontier-sınıfı modeli. SWE-Verified %79.0 Pro'ya yalnızca 1.6 puan geride. 1M token bağlam 10% daha az KV önbellek.",
      "weaknesses": "Çoğu geliştirici iş yükü için Pro ile fark ihmal edilebilir ama kuantum atlama gereken görevlerde arka planda kalıyor. Yerel çalıştırma hâlâ güçlü donanım gerektiriyor. Yalnızca metin."
    },
    "deepseek-v3-2": {
      "strengths": "671B toplam MoE, son derece rekabetçi fiyat ($0.28 giriş). SWE-Verified tutarlı 72-74% aralığı birden fazla çerçeve ile doğrulandı. Açık ağırlık, DeepSeek Sparse Attention ile uzun bağlam optimize edilmiş.",
      "weaknesses": "V4-Pro Nisan 2026'da onu yerinden etti. Bağlam penceresi yalnızca 128K — V4'ün 1M'ine kıyasla yetersiz. DeepSeek Speciale varyantı ile standart model arasında skor tutarsızlığı var."
    },
    "qwen3-coder-30b": {
      "strengths": "30B toplam / 3.3B aktif MoE, $0.07/M girişle son derece uygun fiyatlı. 262K bağlam penceresi, 107 token/sn. Ollama/LMStudio/llama.cpp desteğiyle kolay yerel kurulum.",
      "weaknesses": "AA Zeka Endeksi 20 ile mevcut rekabetçi alanda ortalamanın altında. SWE-Bench puanı bağımsız olarak doğrulanmamış. Qwen3.6-35B-A3B gibi daha yeni modeller açısından artık birincil seçenek değil."
    },
    "devstral-2": {
      "strengths": "SOTA açık ağırlık kodlama ajanı, SWE-Verified %72.2. 256K bağlam, Ollama'da mevcut. Eşlik eden Devstral Small 2 (24B) tek GPU'da çalışıyor. Mistral Vibe CLI ile entegrasyon.",
      "weaknesses": "123B yoğun model, minimum 4x H100-sınıfı GPU gerektiriyor. SWE-bench Verified puanı resmi leaderboard'da henüz doğrulanmadı. Gelir > $20M şirketler için ticari lisans gerekiyor."
    },
    "glm-5-1": {
      "strengths": "SWE-Pro 58.4 ile GPT-5.4 ve Claude Opus 4.6'yı geçiyor. NL2Repo %42.7 tam repo oluşturmada lider. 8 saate kadar özerk görev çalışması. Huawei Ascend 910B ile %100 yerli chip'te eğitim. MIT lisansı açık ağırlık.",
      "weaknesses": "GPQA Diamond %86.2 frontier'ın gerisinde (Claude %94.3). SWE-Bench Verified bağımsız AA skoru mevcut değil. 744B toplam / 40B aktif — yerel çalıştırma pratikte imkânsız."
    },
    "llama-4-scout": {
      "strengths": "10M token bağlam penceresi endüstri rekoru. 17B aktif / 16 uzman MoE — tek H100'de çalışıyor. $0.19/1M (blended) uygun fiyat. Çok modlu.",
      "weaknesses": "SWE-Bench kodlama performansı bağımsız testlerde (Rootly) hayal kırıklığı yarattı. EU kullanıcıları kısıtlandı. Gemma 4 31B artık birçok alanda daha iyi skor alıyor. Benchmark tartışması henüz çözülmedi."
    },
    "llama-4-maverick": {
      "strengths": "400B toplam / 17B aktif 128 uzman MoE. LMArena'da 1400+ skor. GPT-4o ve Gemini 2.0'ı geçen çok modlu ve çok dilli performans. Uygun maliyet.",
      "weaknesses": "Kodlama görevlerinde beklenenden düşük bağımsız sonuçlar. EU kısıtlaması. LMArena için deneysel sürüm gönderme tartışması güvenilirliği etkiledi. 700M+ MAU şirketleri özel lisans gerektiriyor."
    },
    "qwen3-coder-next": {
      "strengths": "80B toplam / 3B aktif hibrit dikkat+MoE mimarisi. Tek RTX 5090 ile yerel çalışıyor. 256K bağlam, 370+ dil. SWE-Verified %58.7 — 10-20x daha fazla aktif parametreli modelleri geride bırakıyor.",
      "weaknesses": "API fiyatlandırması henüz netleşmedi. SWE-Pro bağımsız ölçümü yok. Qwen3-Coder-480B'nin gölgesinde kalıyor. FIM/otomatik tamamlama için optimize edilmemiş."
    },
    "minimax-m2-7": {
      "strengths": "Frontier kalitesi açık ağırlıklı modeller arasında en düşük fiyat noktasında ($0.30 giriş). SWE-Bench ve Terminal-Bench'te güçlü ajansal kodlama. Piyasa medyanının yarısı fiyatla en yüksek zeka endeks skorlarından biri.",
      "weaknesses": "45.7 token/s çıkış hızıyla sınıfının altında kalıyor. Giriş TTFT yüksek (2.18s). MiniMax platform dışında sağlayıcı çeşitliliği sınırlı."
    },
    "minimax-m2-5": {
      "strengths": "SWE-Bench Verified'da %80.2 ile kapalı kaynak frontier modellerini eşliyor. 105 token/sn çıkış hızı sınıfında ortalamanın iki katı. 230B toplam / 10B aktif MoE mimarisi verimli çalışıyor.",
      "weaknesses": "AA Zeka Endeksi 42 ile M2.7'nin gerisinde kalıyor. SWE-Pro ve Terminal-Bench bağımsız doğrulaması eksik. Ekim 2025'te çıkan orijinal M2'nin yerini aldı, artık ikincil bir seçenek."
    },
    "mimo-v2-flash": {
      "strengths": "MIT lisansıyla açık kaynak, 309B toplam / 15B aktif MoE. 1M token bağlam penceresi. SWE-Bench Verified %73.4 ile Claude Sonnet 4.5'i geçiyor. AIME 2025'te %94.1 matematik performansı.",
      "weaknesses": "Fiyatlandırma API'si henüz net değil. SWE-Pro bağımsız ölçümü yok. V2-Pro ve V2.5 serileri çıkınca hızla gölgede kaldı."
    },
    "mimo-v2-pro": {
      "strengths": "1T toplam / 42B aktif MoE, %78 SWE-Bench Verified ile Claude Sonnet 4.6'yı aşıyor. 1M token bağlam, ajansal iş akışları için idealdir. Frontier kalitesinin çok altında fiyat. 'Hunter Alpha' gizli lansmanıyla viral oldu.",
      "weaknesses": "Açık ağırlık yayınlanmadı (sadece API). 256K üzeri bağlam için fiyat 2 katına çıkıyor. SWE-Pro bağımsız ölçümü eksik. V2.5-Pro Nisan 2026'da yerini almaya başladı."
    },
    "mimo-v2-5-pro": {
      "strengths": "Frontier modelleri aynı yetenekle %40-60 daha az token harcayarak eşliyor. SWE-Pro 57.2, ClawEval 63.8, τ³-Bench 72.9. Görüntü/ses/video+metin çok modlu tek model. 672 araç çağrısıyla 4.3 saatte mükemmel derleyici görevi.",
      "weaknesses": "Ağırlıklar henüz açık kaynak değil ('yakında' söz verildi). Önce kamu beta, tam API ölçeklendirilmesi devam ediyor. SWE-Pro skoru self-reported."
    },
    "mimo-v2-5": {
      "strengths": "100-150 token/sn ile hızlı günlük kullanım modeli. Muse Spark'a kıyasla %50 daha az token kullanımı. Tüm modaliteleri destekliyor ($0.40 giriş uygun fiyatlı). V2-Pro ve V2-Omni'yi tek modelde birleştiriyor.",
      "weaknesses": "Tam parametre sayısı ayrıca açıklanmadı (Pro ile paylaşılıyor olabilir). Benchmark skoru henüz bağımsız doğrulanmadı. Ağırlıklar henüz açık kaynak değil."
    },
    "step-3-5-flash": {
      "strengths": "196B toplam / 11B aktif MoE açık kaynak. 100-350 token/sn üretim hızı. SWE-Verified %74.4, τ²-Bench 88.2 ile güçlü ajansal kodlama. $0.10/$0.30 piyasanın en ucuz seçeneklerinden.",
      "weaknesses": "Benchmarkların tamamı self-reported (StepFun). vLLM/llama.cpp ile yerel çalışırken VRAM gereksinimi yüksek. Bağımsız platform doğrulaması sınırlı."
    },
    "deepseek-v4-pro": {
      "strengths": "1.6T toplam / 49B aktif MoE, açık ağırlık MIT. SWE-Verified %80.6 (Claude Opus 4.6'ya 0.2 puan fark), LiveCodeBench %93.5. V3.2'ye kıyasla %73 daha az FLoP, 1M token bağlam, frontier kalitesinin çok altında fiyat.",
      "weaknesses": "Yerel çalıştırmak için minimum 8x H100 80GB GPU gerekiyor. Preview aşamasında bant genişliği kısıtlı. HLE %37.7 ile frontier modellerinin gerisinde. Yalnızca metin destekli, görüntü/ses yok."
    },
    "qwen3-coder-480b": {
      "strengths": "Açık ağırlıklar arasında ajansal kodlamada SOTA. Aider Polyglot %61.8 Claude Sonnet 4 ile eşit. 7.5T token (%70 kod) eğitim verisi, 358 programlama dili. QwenCode CLI açık kaynak sunuldu.",
      "weaknesses": "480B toplam parametre yerel çalıştırmayı pratikte imkânsız kılıyor (birden fazla H100 düğümü gerekli). 256K bağlam penceresi 1M sunan rakiplere kıyasla kısıtlı. Düşünme modu desteklenmiyor."
    },
    "devstral-medium": {
      "strengths": "24B parametre, Apache 2.0 lisansı, 32GB RAM dizüstü bilgisayarda çalışıyor. SWE-Verified %68 güçlü yerel kodlama. Çok modlu (görüntü girişi destekli). $0.10/$0.30 uygun fiyatlı.",
      "weaknesses": "Devstral 2 123B'ye kıyasla 4.2 puan geride. Görüntü çıkışı yok. Yerel performans tam hassasiyet için 32GB+ RAM gerektiriyor."
    },
    "codestral-22b": {
      "strengths": "HumanEval %86.6, MBPP %91.2. 256K bağlam penceresi repo-ölçeği kod tamamlama için ideal. 22B parametreyle RTX 4090'da tam hassasiyet çalışıyor. FIM (fill-in-the-middle) desteği IDE entegrasyonu için mükemmel.",
      "weaknesses": "Ticari olmayan lisans girişim benimsemesini kısıtlıyor. SWE-Bench Verified bağımsız skoru yok. Devstral ve Qwen3-Coder gibi yeni ajansal modellerin gölgesinde kaldı."
    },
    "nemotron-3-super": {
      "strengths": "Hibrit Mamba-Transformer mimarisi (LatentMoE) 5x daha yüksek throughput. NVFP4 ile 64GB VRAM'da çalışıyor (tek H100 SXM). SWE-Verified %60.5 açık ağırlık rekoru (çıkış tarihinde). 1M token bağlamda %91.75 RULER. Cloudflare Workers AI'da ücretsiz.",
      "weaknesses": "SWE-Verified %60.5 Nisan 2026 itibarıyla DeepSeek V4-Pro (%80.6) ve Kimi K2.6 (%80.2) tarafından geride bırakıldı. İngilizce dışı kodlamada %45.8 ile önemli düşüş. BF16 tam ağırlıklar için 3-4x H100 gerekiyor."
    },
    "gemma-4-e2b": {
      "strengths": "2.3B etkin parametre, telefon ve edge cihazlarda çalışıyor (~1.5GB 4-bit). Ses girişi desteği (30s konuşma tanıma). Apache 2.0 lisansı. 128K bağlam. Çok dilli (140+ dil) ve çok modlu.",
      "weaknesses": "Kodlama benchmark verileri ayrıca raporlanmadı. E4B veya üzeri tercih edildiği için gerçek kodlama görevlerinde sınırlı kullanım. Fiyatlandırma henüz belirsiz."
    },
    "gemma-4-e4b": {
      "strengths": "4.5B etkin parametre, 8GB RAM dizüstüde çalışıyor (~5GB 4-bit). Ses girişi dahil tam çok modlu destek. Apache 2.0. İşlev çağırma ve yapılandırılmış JSON çıkışı yerleşik.",
      "weaknesses": "Kodlama benchmark skoru ayrıca yayınlanmadı. 128K bağlam penceresi 26B/31B varyantlarının 256K'sının yarısı. Fiyatlandırma belirsiz."
    },
    "gemma-4-26b-moe": {
      "strengths": "26B toplam / 3.8B aktif MoE, RTX 4090'da 24GB ile çalışıyor (Q4). Arena AI'da küresel #6. AIME 2026 %88.3 verimlilik için etkileyici. 31B yoğun modelin %97'si kalitesini 1/8 hesaplama ile sunuyor.",
      "weaknesses": "SWE-Verified %64 GLM-5.1 (%78) ve Claude'un (%87.6) gerisinde. Hâlâ 26GB yüklemesi gerektiriyor (sadece 3.8B aktif olmasına rağmen). Kodlama ajanı senaryolarında 31B Yoğun'a tercih edilmiyor."
    },
    "gemma-4-31b": {
      "strengths": "Apache 2.0 ile en iyi ABD açık modeli. Arena AI #3 (Elo 1452). AIME 2026 %89.2 güçlü matematik. τ²-Bench 86.4 etkileyici ajan performansı. 256K bağlam. Tam çok modlu.",
      "weaknesses": "SWE-Verified %64 GLM-5.1 ve Kimi K2.6 gibi Çin modellerin gerisinde. Tam hassasiyet için 80GB H100 gerekiyor. Fiyatlandırma henüz açıklanmadı (Google AI Studio ücretsiz önizleme)."
    },
    "gemma-3-27b": {
      "strengths": "27B yoğun model, tek GPU'da tam hassasiyet çalışıyor. DeepInfra'da $0.10/1M giriş ile son derece ucuz. 140+ dil, görüntü+metin çok modlu. İnce ayar için iyi temel.",
      "weaknesses": "LiveCodeBench v6 %29.1 ile mevcut kodlama standartlarında çok düşük. Gemma 4 Nisan 2026'da dramatik biçimde onu geride bıraktı (Codeforces ELO: 110 vs 2150). Ajansal araç kullanımı %6.6 kabul edilemez düşük."
    },
    "qwen25-coder-32b": {
      "strengths": "14.7M Ollama indirmesiyle yerel kodlama için #1 tercih. HumanEval %92.7, Aider %73.7. FIM (fill-in-the-middle) ile en iyi otomatik tamamlama modeli. RTX 4090'da Q4_K_M ile 22GB VRAM'da çalışıyor.",
      "weaknesses": "32K bağlam penceresi modern standartlarda sınırlı (not: Unsloth 128K versiyonu mevcut). Qwen3.6 ailesi ile karşılaştırıldığında ajansal kodlamada zayıf. Yalnızca metin, çok modlu değil."
    },
    "qwen25-coder-14b": {
      "strengths": "9GB dosya boyutu — 12GB VRAM GPU'larda (RTX 3060/4060) güçlü kodlama. FIM desteği ile IDE otomatik tamamlama için idealdir. Apache 2.0 lisansı ile ticari kullanım özgür.",
      "weaknesses": "32K bağlam penceresi kısıtlı. 32B varyantına kıyasla benchmark performansı düşer. Ajansal kodlama için 32B veya üzeri tercih edilmeli."
    },
    "qwen25-coder-7b": {
      "strengths": "4.7GB boyut, 8GB VRAM GPU (RX 580, GTX 1070) dahil çalışıyor. FIM desteği ile hafif IDE entegrasyonu. Apache 2.0. Giriş seviyesi yerel kodlama için en iyi seçenek.",
      "weaknesses": "32K bağlam penceresi ve 7B parametre ciddi ajansal görevi kaldırmaz. Daha güçlü donanımda 14B veya 32B tercih edin. Benchmark rakamları 32B'nin önemli ölçüde altında."
    },
    "deepseek-coder-v2-16b": {
      "strengths": "16B MoE varyantı 8.9GB ile 12GB VRAM'da çalışıyor. 160K bağlam penceresi yerel modeller arasında oldukça geniş. GPT4-Turbo ile karşılaştırılabilir performans (çıkış dönemi). 2.4M Ollama indirmesi.",
      "weaknesses": "2024'ten itibaren güncel yeni modeller tarafından önemli ölçüde geride bırakıldı. 236B varyantı pratikte çalıştırılamaz (133GB). Lisans DeepSeek'e özgü Apache/MIT değil."
    },
    "deepseek-r1-14b": {
      "strengths": "Qwen2.5'ten damıtılmış, 128K bağlam penceresi ile güçlü akıl yürütme. MIT lisansı. 9GB dosya boyutu 12GB VRAM GPU'larda rahatça çalışıyor. Yerel matematiksel akıl yürütme için popüler.",
      "weaknesses": "Distilled model — tam R1 671B kapasitesinde değil. Kodlama benchmark skoru bağımsız olarak raporlanmamış. DeepSeek V4 serisinin gölgesinde kaldı."
    },
    "qwen-3-6-max": {
      "strengths": "AA Zeka Endeksi 52 ile yüksek sıralamada. SWE-Pro, Terminal-Bench 2.0, SkillsBench, QwenClawBench, QwenWebBench, SciCode dahil 6 benchmark'ta #1. Ajan iş akışları için preserve_thinking özelliği.",
      "weaknesses": "Kapalı ağırlık (Qwen tarihinde ilk kez). SWE-Bench Verified bağımsız skoru yayınlanmadı. Ön izleme döneminde fiyatlandırma netleşmedi. Görüntü/ses yok — yalnızca metin."
    }
  },
