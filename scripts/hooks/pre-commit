#!/usr/bin/env sh
# Pre-commit hook: HARD BLOCK on SSOT coherence drift.
#
# Runs scripts/audit-data-coherence.py against the working tree. If the audit
# detects ANY drift between bench keys / model ids / i18n / data / sources /
# whitelist surfaces, the commit is rejected loudly and the user is told what
# to fix.
#
# To bypass for a true emergency: `git commit --no-verify` (do NOT use this
# unless you have a documented reason — drift commits cause silent rendering
# bugs downstream).
#
# Activation: `bash scripts/install-hooks.sh` (sets core.hooksPath).

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
AUDIT="$REPO_ROOT/scripts/audit-data-coherence.py"
BENCH_AUDIT="$REPO_ROOT/scripts/audit-bench-source-mapping.py"

# Resolve python interpreter: prefer python3, fall back to python (Windows).
if command -v python3 >/dev/null 2>&1; then
  PY=python3
elif command -v python >/dev/null 2>&1; then
  PY=python
else
  echo "pre-commit: no python interpreter found — skipping audits" >&2
  exit 0
fi

if [ ! -f "$AUDIT" ]; then
  # Audit script missing — let the commit through; absent audit is itself a
  # repo-state issue but blocking all commits would be worse than logging.
  echo "pre-commit: audit script missing at $AUDIT — skipping (this is unusual)"
  exit 0
fi

if ! "$PY" "$AUDIT" >/dev/null 2>&1; then
  echo "" >&2
  echo "✗ COMMIT BLOCKED — SSOT coherence drift detected." >&2
  echo "" >&2
  echo "  Surfaces (BENCH_KEYS, i18n, data/models.json, data/sources.json," >&2
  echo "  data/sources-whitelist.json, DEFAULT_WEIGHTS, PRESETS) disagree." >&2
  echo "" >&2
  echo "  Run the audit to see the exact drift:" >&2
  echo "    python scripts/audit-data-coherence.py" >&2
  echo "" >&2
  echo "  Fix every reported diff, then re-stage and re-commit." >&2
  echo "  Emergency override (NOT for routine use): git commit --no-verify" >&2
  echo "" >&2
  exit 1
fi

# AC6/AC7 — bench-source mapping audit. WARN-only during W1 phase
# (AICODERMAP_BENCH_SOURCE_WARN_ONLY=1); HARD BLOCK after W2 activation.
if [ -f "$BENCH_AUDIT" ]; then
  if ! "$PY" "$BENCH_AUDIT" >/dev/null 2>&1; then
    echo "" >&2
    echo "✗ COMMIT BLOCKED — bench-source mapping drift (AC6/AC7)." >&2
    echo "" >&2
    echo "  A coreBenchKey has no whitelisted publisher, OR a leaderboard" >&2
    echo "  advertises a bench key that isn't canonical. See:" >&2
    echo "    python scripts/audit-bench-source-mapping.py" >&2
    echo "" >&2
    echo "  Either add the publisher mapping to data/sources-whitelist.json" >&2
    echo "  leaderboards[].publishes[], or move the key into" >&2
    echo "  _schema.deprecatedBenchKeys (and update core.js BENCH_KEYS)." >&2
    echo "" >&2
    echo "  W1 migration override:" >&2
    echo "    AICODERMAP_BENCH_SOURCE_WARN_ONLY=1 git commit ..." >&2
    echo "  Emergency override: git commit --no-verify" >&2
    echo "" >&2
    exit 1
  fi
fi

exit 0
