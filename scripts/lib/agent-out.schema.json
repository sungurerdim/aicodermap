{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "agent-out.schema.v1",
  "title": "AICoderMap agent output artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["cycleDate", "models", "gaps"],
  "properties": {
    "cycleDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "generatedAt": { "type": "string" },
    "partialReturn": { "type": "boolean" },
    "partialReason": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "enum": ["completeness", "wallclock", "fetch_quota", "spa_dead"]
            },
            "cellsAttempted": { "type": "integer", "minimum": 0 },
            "cellsFilled": { "type": "integer", "minimum": 0 },
            "topBlockingSources": { "type": "array", "items": { "type": "string" } }
          }
        }
      ]
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id":              { "type": "string", "minLength": 1 },
          "modelId":         { "type": "string" },
          "updates": {
            "type": "object",
            "properties": {
              "bench": {
                "type": ["object", "null"],
                "description": "Canonical bench keys: _schema.coreBenchKeys ∪ emergingBenchKeys. Enforced at runtime by scripts/validate-artifact-keys.py — dynamic key universe cannot be embedded in static schema. Non-canonical keys (e.g., lcbV6, aider when deprecated) cause pre-merge REJECT (FAZ 8.A, 2026-05-18). Flat `bench.X` keys at updates root rejected by validate-agent-out.py."
              }
            }
          },
          "sourcesAdded": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["key"],
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_-]+\\.[a-zA-Z0-9]+$"
                },
                "value": {},
                "source": { "type": "string" },
                "url": { "type": "string" },
                "tier": { "type": "string", "enum": ["I", "S", "C"] },
                "trustScore": { "type": "number", "minimum": 0, "maximum": 1 },
                "fetched": { "type": "string" },
                "verifications": { "type": "integer", "minimum": 1 }
              }
            }
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["key"],
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]+\\.[a-zA-Z0-9]+$"
              },
              "reason":        { "type": "string" },
              "triedSources":  { "type": "array", "items": { "type": "string" } },
              "triedQueries":  { "type": "array", "items": { "type": "string" } },
              "triedFormats":  { "type": "array", "items": { "type": "string" } },
              "autoGenerated": { "type": "boolean" }
            }
          },
          {
            "type": "object",
            "required": ["modelId", "field"],
            "properties": {
              "modelId":       { "type": "string", "minLength": 1 },
              "field":         { "type": "string", "minLength": 1 },
              "reason":        { "type": "string" },
              "triedSources":  { "type": "array", "items": { "type": "string" } },
              "triedQueries":  { "type": "array", "items": { "type": "string" } },
              "triedFormats":  { "type": "array", "items": { "type": "string" } },
              "autoGenerated": { "type": "boolean" }
            }
          }
        ]
      }
    },
    "newModels":        { "type": "array" },
    "lineup":           { "type": "object" },
    "lineupChanges":    {
      "type": "object",
      "description": "Diff-shaped Step-0 lineup output {new[],deprecated[],renamed[],removed[]} consumed by merge.py's _process_lineup_changes(). Distinct from `lineup` (raw per-vendor active/deprecated/renamed dict). Produced by gen_unified_artifact.py's batch union and local-synth.py; must survive gap_gen.py's artifact reconstruction (2026-07-16: gap_gen previously dropped this key, silently disabling all lineup-driven deprecations)."
    },
    "contradictions":   { "type": "array" },
    "whitelistAdditions": { "type": "array" },
    "i18nUpdates":      { "type": "object" },
    "runtime":          { "type": "object" },
    "coverageMatrix": {
      "type": "object",
      "properties": {
        "filledCells":       { "type": "integer", "minimum": 0 },
        "gapsRecorded":      { "type": "integer", "minimum": 0 },
        "expectedTotal":     { "type": "integer", "minimum": 0 }
      }
    },
    "validationCoverage": { "type": "number", "minimum": 0, "maximum": 1 },
    "_telemetry": {
      "type": "object",
      "description": "Per-batch telemetry injected by orchestrator post-dispatch",
      "properties": {
        "_batchId":     { "type": "string", "minLength": 1 },
        "_wallclockSec":{ "type": "number", "minimum": 0 },
        "_startedAt":   { "type": "number" },
        "_endedAt":     { "type": "number" },
        "_toolCalls":   { "type": "integer", "minimum": 0 }
      }
    }
  }
}
